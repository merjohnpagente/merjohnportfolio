# Secrets / env - never commit
.env
.env.local
firebase-config.js
*.key
*.pem

# Dependencies
node_modules/
vendor/

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editors / local tooling (kept local, not on GitHub)
.vscode/
.opencode/
.idea/

# Local docs / prompts (private)
docs/
prompts/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs (if you add a bundler later)
dist/
build/
*.map

# Keep portfolio core files TRACKED (do NOT ignore these or live site breaks):
# !index.html
# !style.css
# !script.js
# !assets/
# CDN scripts (gsap, ScrollTrigger, lenis) are public CDN — gitignore can't hide them from View Source.
# To make View Source unreadable, minify/bundle script.js instead of hiding the <script> tag.
